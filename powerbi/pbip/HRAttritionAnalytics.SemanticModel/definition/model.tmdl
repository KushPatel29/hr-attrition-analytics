model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["dim_department", "dim_job", "dim_location", "dim_date", "fact_employees", "workforce_kpis", "headcount_bridge", "attrition_by_dimension", "retention_cohorts", "pay_equity", "pay_equity_levels", "funnel_stages", "recruiting_by_source", "recruiting_kpis", "flight_risk_scores", "model_evaluation", "_Measures", "DataPath"]

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode"]

ref table dim_department
ref table dim_job
ref table dim_location
ref table dim_date
ref table fact_employees
ref table workforce_kpis
ref table headcount_bridge
ref table attrition_by_dimension
ref table retention_cohorts
ref table pay_equity
ref table pay_equity_levels
ref table funnel_stages
ref table recruiting_by_source
ref table recruiting_kpis
ref table flight_risk_scores
ref table model_evaluation
ref table _Measures

