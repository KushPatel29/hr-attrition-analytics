			        & "<text x='16' y='64' font-family='Segoe UI Light' font-size='30' fill='" & vValueFill & "'>" & vShown & "</text>"
			        & ""
			        & "<text x='16' y='90' font-family='Segoe UI' font-size='10' fill='#8B90B8'>" & vCaption & "</text>"
			        & "</svg>"
			RETURN
			    "data:image/svg+xml;utf8," & SUBSTITUTE(SUBSTITUTE(vSvg, "%", "%25"), "#", "%23")
		lineageTag: 8197e274-abb3-5379-8d0a-8b7f822e603c
		dataCategory: ImageUrl
		displayFolder: Report UI

	measure 'KPI SVG Model ROC-AUC' =
			VAR vValue = [Model ROC-AUC]
			VAR vShown = IF(ISBLANK(vValue), "—", IF(ABS(vValue) >= 1000000, FORMAT(vValue / 1000000, "#,0.00") & "M", FORMAT(vValue, "0.000")))
			VAR vCaptionRaw = ""
			VAR vCaption = IF(LEN(vCaptionRaw) > 58, LEFT(vCaptionRaw, 56) & "…", vCaptionRaw)
			VAR vAccent = "#8B8BFF"
			VAR vValueFill = "#FFFFFF"
			VAR vSvg =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='296' height='112' viewBox='0 0 296 112'>"
			        & "<rect x='0' y='18' width='3' height='76' rx='1.5' fill='" & vAccent & "'/>"
			        & "<text x='16' y='28' font-family='Segoe UI' font-size='11' fill='#A6ABD1'>Model ROC-AUC</text>"
			        & "<text x='16' y='64' font-family='Segoe UI Light' font-size='30' fill='" & vValueFill & "'>" & vShown & "</text>"
			        & ""
			        & "<text x='16' y='90' font-family='Segoe UI' font-size='10' fill='#8B90B8'>" & vCaption & "</text>"
			        & "</svg>"
			RETURN
			    "data:image/svg+xml;utf8," & SUBSTITUTE(SUBSTITUTE(vSvg, "%", "%25"), "#", "%23")
		lineageTag: 02885b8a-18cd-5f3e-a04d-2c7de85dfca6
		dataCategory: ImageUrl
		displayFolder: Report UI

	measure 'Filter Context - Flight Risk (ML)' =
			VAR vText = IF(ISFILTERED('flight_risk_scores'[risk_band]), CONCATENATEX(VALUES('flight_risk_scores'[risk_band]), 'flight_risk_scores'[risk_band], ", "), "all risk band")
			RETURN IF(LEN(vText) > 72, LEFT(vText, 70) & "…", vText)
		lineageTag: 2c5e9381-475d-565f-991a-307bd2d57e43
		displayFolder: Report UI

	measure 'Header SVG - Flight Risk (ML)' =
			VAR vContext = "Page 8 of 8 · " & SUBSTITUTE(SUBSTITUTE([Filter Context - Flight Risk (ML)], "&", "&amp;"), "<", "&lt;")
			VAR vSvg =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='440' height='56' viewBox='0 0 440 56'>"
			        & "<text x='0' y='24' font-family='Segoe UI Semibold' font-size='18' fill='#EDEFFA'>Flight Risk (ML)</text>"
			        & "<text x='0' y='46' font-family='Segoe UI' font-size='11' fill='#8B90B8'>" & vContext & "</text>"
			        & "</svg>"
			RETURN
			    "data:image/svg+xml;utf8," & SUBSTITUTE(SUBSTITUTE(vSvg, "%", "%25"), "#", "%23")
		lineageTag: 1bef6472-7ff7-50c1-9860-cf4db35cf5fe
		dataCategory: ImageUrl
		displayFolder: Report UI

