table _Measures
	lineageTag: 3bfbd78c-7d53-4ddf-a377-ad73b50c2c49

	measure 'Total Employees' = COUNTROWS(fact_employees)
		formatString: #,0
		lineageTag: 6fb5be48-9231-4a88-829e-e2aff085f89a

	measure Headcount = CALCULATE(COUNTROWS(fact_employees), fact_employees[is_active] = 1)
		formatString: #,0
		lineageTag: ee9bbd7f-d71e-4ca7-9afe-699f43f59a59

	measure Terminations = CALCULATE(COUNTROWS(fact_employees), fact_employees[is_active] = 0)
		formatString: #,0
		lineageTag: 743aef94-0ecc-4745-a662-7a23c7ae381b

	measure 'Voluntary Terminations' = CALCULATE(COUNTROWS(fact_employees), fact_employees[term_type] = "Voluntary")
		formatString: #,0
		lineageTag: 04e5023c-bd71-45d7-b0a0-7f5424e3e046

	measure 'Involuntary Terminations' = CALCULATE(COUNTROWS(fact_employees), fact_employees[term_type] = "Involuntary")
		formatString: #,0
		lineageTag: cb33505f-04a1-4191-8912-93d44c8cf48e

	measure 'Separation Rate' = DIVIDE([Terminations], [Total Employees])
		formatString: 0.0%
		lineageTag: 25f51636-0f11-45fe-888e-24c5edd0819e

	measure 'Voluntary %' = DIVIDE([Voluntary Terminations], [Terminations])
		formatString: 0.0%
		lineageTag: 97196e9c-27f0-47f0-b094-b36849be625d

	measure 'Avg Tenure (Months)' = AVERAGE(fact_employees[tenure_months])
		formatString: #,0.0
		lineageTag: 0c6f6ea7-5b3e-4dc6-b431-127393b2d3b0

	measure 'Avg Tenure (Yrs)' = DIVIDE([Avg Tenure (Months)], 12)
		formatString: #,0.0
		lineageTag: 2b03002c-ae00-4ef3-af31-c11aa576e5ce

	measure 'Avg Salary' = AVERAGE(fact_employees[base_salary])
		formatString: \$#,0
		lineageTag: 9da29fd1-a646-4344-bd69-48ab03c7cd28

	measure 'Avg Engagement' = AVERAGE(fact_employees[engagement_score])
		formatString: #,0.0
		lineageTag: e33ede9c-d4a9-4bc6-a655-d866e297a8f8

	measure 'Avg Compa-Ratio' = AVERAGE(fact_employees[compa_ratio])
		formatString: 0.00
		lineageTag: b4b147c1-6fed-47dd-8b07-78c2d2ae7cf7

	measure 'Attrition Rate (T12M)' = VAR L = CALCULATE(MAX(workforce_kpis[month]), ALL(workforce_kpis)) RETURN CALCULATE(MAX(workforce_kpis[rolling_12m_attrition_rate]), workforce_kpis[month] = L)
		formatString: 0.0%
		lineageTag: 3754c426-f2ea-4af8-b8be-adfb17dd84fb

	measure 'Attrition Target' = 0.15
		formatString: 0.0%
		lineageTag: ab3b4606-412a-4b4f-a375-57eeb1c3f34e

	measure 'Compa Target' = 1
		formatString: 0.00
		lineageTag: 9b637c93-ea10-42b5-858f-22d53caa6351

	measure 'Scored Employees' = COUNTROWS(flight_risk_scores)
		formatString: #,0
		lineageTag: cfab1e83-c75c-4e43-bcac-b05bfe6d8a3f

	measure 'High Risk Count' = CALCULATE(COUNTROWS(flight_risk_scores), flight_risk_scores[risk_band] = "High")
		formatString: #,0
		lineageTag: 89beb2ff-0cce-4fde-ab28-6e8063d7a598

	measure 'High Risk %' = DIVIDE([High Risk Count], [Scored Employees])
		formatString: 0.0%
		lineageTag: ceccf228-16a1-4b2a-b673-176952527b22

	measure 'Avg Risk Score' = AVERAGE(flight_risk_scores[risk_score])
		formatString: 0.00
		lineageTag: d6496bdb-2280-4979-a597-8480d6a37bf5

	measure 'Avg Tenure (Scored)' = AVERAGE(flight_risk_scores[tenure_months])
		formatString: #,0.0
		lineageTag: 37023e18-f6e0-4755-9cbd-41ad4bda0816

	measure 'Avg Engagement (Scored)' = AVERAGE(flight_risk_scores[engagement_score])
		formatString: #,0.0
		lineageTag: 97d8673f-c84c-462e-a7b4-f1c340f37ae9

	measure 'Adjusted Pay Gap' = CALCULATE(MAX(pay_equity[raw_gap_pct]), pay_equity[job_level] = "ALL (level-adjusted)")
		formatString: 0.0%
		lineageTag: cad34d04-7e04-44ba-8c53-5939446655fb

	measure 'Total Applications' = MAX(recruiting_kpis[total_applications])
		formatString: #,0
		lineageTag: b0a9b4e9-d80f-4f47-b1bd-abe67764569f

	measure 'Total Hires' = MAX(recruiting_kpis[total_hires])
		formatString: #,0
		lineageTag: 3eebbb0c-177d-4448-b50e-0ecd99972c97

	measure 'Applied to Hired %' = MAX(recruiting_kpis[overall_hire_rate])
		formatString: 0.0%
		lineageTag: 462aa664-60ae-4ecf-956d-7a264e15ec07

	measure 'Offer Accept Rate' = MAX(recruiting_kpis[offer_accept_rate])
		formatString: 0.0%
		lineageTag: 5de964e4-b4ec-48ac-a487-d587107a8b0e

	measure 'Median Time to Fill' = MAX(recruiting_kpis[median_days_to_fill])
		formatString: #,0
		lineageTag: 110489b9-fc99-4db7-aac9-9e63a87985c0

	measure 'Model ROC-AUC' = CALCULATE(MAX(model_evaluation[roc_auc]), model_evaluation[is_chosen] = 1)
		formatString: 0.000
		lineageTag: d9574c13-fbd2-4be0-aa46-1c73da5248ac

	measure 'Top Decile Lift' = CALCULATE(MAX(model_evaluation[lift_at_decile]), model_evaluation[is_chosen] = 1)
		formatString: 0.0
		lineageTag: 1de4a2e0-3717-4a20-b73d-fa33b3af1328

	measure 'Retention Rate' = AVERAGE(retention_cohorts[retention_rate])
		formatString: 0.0%
		lineageTag: 8651da2b-8339-44a8-b4a5-5332eccb5bbf

	measure 'Retention @ 12mo' = CALCULATE(AVERAGE(retention_cohorts[retention_rate]), retention_cohorts[cohort_year] = "All", retention_cohorts[months_since_hire] = 12)
		formatString: 0.0%
		lineageTag: 08c89421-8a62-4af3-8d01-87c4f3a2909b

	measure Candidates = SUM(funnel_stages[candidates])
		formatString: #,0
		lineageTag: d1a50635-1900-42ab-9363-234d529fe952

	measure 'Monthly Headcount' = SUM(workforce_kpis[headcount])
		formatString: #,0
		lineageTag: 7a06a43a-1914-49c0-875b-ce5ece0947aa

	measure 'Bridge Value' = SUM(headcount_bridge[value])
		formatString: #,0
		lineageTag: ccfc8468-8f0a-48be-ad6e-677f2fc41e88

	measure 'Rolling 12m Attrition' = AVERAGE(workforce_kpis[rolling_12m_attrition_rate])
		formatString: 0.0%
		lineageTag: 5e7aa984-9a97-4128-a8ca-b7a18c5528f8

	measure 'Avg Salary (F)' = AVERAGE(pay_equity_levels[avg_salary_female])
		formatString: \$#,0
		lineageTag: 3c4a2614-6340-4ad5-8304-da98b778325d

	measure 'Avg Salary (M)' = AVERAGE(pay_equity_levels[avg_salary_male])
		formatString: \$#,0
		lineageTag: 95ec477c-32f4-4abf-abc0-1b6020e04812

	measure 'Src Hire Rate' = AVERAGE(recruiting_by_source[hire_rate])
		formatString: 0.0%
		lineageTag: aca7bba3-e230-42da-ad9d-3109fd54da31

	measure 'Src Time to Fill' = AVERAGE(recruiting_by_source[avg_days_to_fill])
		formatString: #,0
		lineageTag: 2fe16b7d-b7dc-4c22-9bfb-5a62e01ff644

	/// The half of the KPI that was missing: attrition against what?
	measure 'Attrition vs Target' = [Attrition Rate (T12M)] - [Attrition Target]
		formatString: +0.0%;-0.0%;0.0%
		lineageTag: 38423dbf-a24a-55e3-b7d9-95f73e040cf8
		displayFolder: Verdict

	/// The model decides what 'bad' means, once, instead of every reader deciding for themselves in the meeting.
	measure 'Attrition Status' =
			VAR Actual = [Attrition Rate (T12M)]
			VAR Target = [Attrition Target]
			RETURN
			    SWITCH(
			        TRUE(),
			        ISBLANK(Actual), "No data",
			        Actual <= Target, "On target",
			        Actual <= Target + 0.01, "Watch",
			        "Off target"
			    )
		lineageTag: e20c7ceb-71c9-55f3-bde9-4d79ab825bca
		displayFolder: Verdict

	/// Bind to Conditional formatting -> Field value. The hex values are the Meridian Nocturne semantic colours, so report and theme cannot drift apart.
	measure 'Attrition Colour' =
			SWITCH(
			    [Attrition Status],
			    "On target", "#3DD68C",
			    "Watch", "#F5A524",
			    "No data", "#454A82",
			    "#FF5C7A"
			)
		lineageTag: d829203c-da29-5cb3-8520-ef58867295b5
		displayFolder: Verdict

	/// Reference line under the callout, shown as the card's subtitle.
	measure 'Attrition Reference' =
			VAR Gap = [Attrition vs Target]
			VAR Above = Gap >= 0
			RETURN
			    "Target " & FORMAT([Attrition Target], "0.0%") & "   "
			        & IF(Above, "▲", "▼") & " "
			        & FORMAT(ABS(Gap) * 100, "0.0") & " pts" & IF(Above, " over", " under")
		lineageTag: d88470f5-d739-5d0f-956d-1ba435346045
		displayFolder: Verdict

	/// Card subtitle for Headcount.
	measure 'Headcount Reference' = "Terminations " & FORMAT([Terminations], "#,0") & "   Voluntary " & FORMAT([Voluntary %], "0.0%")
		lineageTag: 59e0917d-58bf-5cd3-8356-2cb3aafbf173
		displayFolder: Verdict

	/// A count of high-risk employees means nothing without its denominator.
	measure 'High Risk Reference' = "of " & FORMAT([Scored Employees], "#,0") & " scored   avg score " & FORMAT([Avg Risk Score], "0.00")
		lineageTag: 41d7948d-6574-5137-a0e4-ab74e2a044da
		displayFolder: Verdict

	/// Departments above the attrition target read red.
	measure 'Department Attrition Colour' =
			IF(
			    [Separation Rate] > [Attrition Target],
			    "#FF5C7A",
			    "#454A82"
			)
		lineageTag: e3011e1b-d6a5-5879-9607-4819d53c8b75
		displayFolder: Verdict

	/// Highlights the largest value on the axis and recedes the rest.
	/// The bare ALLSELECTED() is what makes this work inside a conditional
	/// format: it restores the VISUAL's filter context, so VALUES() is the
	/// axis rather than the single data point. Iterating the column alone
	/// leaves the point's own filter in place and every bar matches itself;
	/// iterating the table walks rows, which is not the axis unless the
	/// dimension happens to have one row per value.
	measure 'Tenure Band Colour' =
			VAR Here = [Separation Rate]
			VAR Extreme =
			    CALCULATE(
			        MAXX(VALUES(fact_employees[tenure_band]), [Separation Rate]),
			        ALLSELECTED()
			    )
			RETURN
			    IF(Here = Extreme, "#FF5C7A", "#454A82")
		lineageTag: b89acd8a-2e71-5af7-91a9-6f199a42e2a4
		displayFolder: Verdict

	/// Highlights the largest value on the axis and recedes the rest.
	/// The bare ALLSELECTED() is what makes this work inside a conditional
	/// format: it restores the VISUAL's filter context, so VALUES() is the
	/// axis rather than the single data point. Iterating the column alone
	/// leaves the point's own filter in place and every bar matches itself;
	/// iterating the table walks rows, which is not the axis unless the
	/// dimension happens to have one row per value.
	measure 'Source Hire Rate Colour' =
			VAR Here = [Src Hire Rate]
			VAR Extreme =
			    CALCULATE(
			        MAXX(VALUES(recruiting_by_source[source]), [Src Hire Rate]),
			        ALLSELECTED()
			    )
			RETURN
			    IF(Here = Extreme, "#3DD68C", "#454A82")
		lineageTag: d8967292-b9b8-53d4-9300-f0942e7b8cd1
		displayFolder: Verdict

	/// Closes on the governance point, because on people data that IS the headline.
	measure 'Workforce Insight' =
			VAR Rate = [Attrition Rate (T12M)]
			VAR Gap = Rate - [Attrition Target]
			VAR WorstDept =
			    MAXX(TOPN(1, VALUES(dim_department[department]), [Separation Rate], DESC), dim_department[department])
			VAR WorstRate = CALCULATE([Separation Rate], dim_department[department] = WorstDept)
			RETURN
			    "Attrition " & FORMAT(Rate, "0.0%") & " against a " & FORMAT([Attrition Target], "0.0%")
			        & " target — " & IF(Gap <= 0, "on target", FORMAT(Gap * 100, "0.0") & " pts over")
			        & ". " & WorstDept & " is the hardest hit at " & FORMAT(WorstRate, "0.0%")
			        & ", and " & FORMAT([High Risk Count], "#,0") & " of " & FORMAT([Scored Employees], "#,0")
			        & " scored employees are flagged high risk. The model reads no protected attribute."
		lineageTag: c6808a44-f177-59cd-a590-97aae82e154e
		displayFolder: Verdict

	column Value
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 06890663-86f6-428a-9e78-62eaf601d760
		summarizeBy: none
		sourceColumn: Value

	partition _Measures = m
		mode: import
		source =
				let
				    Source = #table(type table [Value = Int64.Type], {})
				in
				    Source

