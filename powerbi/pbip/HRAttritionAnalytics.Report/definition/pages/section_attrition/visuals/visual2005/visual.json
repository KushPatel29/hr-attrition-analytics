              },
              "queryRef": "fact_employees.term_type",
              "nativeQueryRef": "term_type",
              "active": true
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "_Measures"
                    }
                  },
                  "Property": "Terminations"
                }
              },
              "queryRef": "_Measures.Terminations",
              "nativeQueryRef": "Terminations"
            }
          ]
        }
      }
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Voluntary vs Involuntary'"
