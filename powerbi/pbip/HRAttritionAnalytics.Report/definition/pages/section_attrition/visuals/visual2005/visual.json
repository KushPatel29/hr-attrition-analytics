                }
              }
            }
          }
        }
      ]
    },
    "drillFilterOtherVisuals": true,
    "objects": {
      "labels": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
